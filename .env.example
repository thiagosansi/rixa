# Transporte realtime: 'ws' (servidor local, padrao) ou 'supabase' (hospedado)
NEXT_PUBLIC_TRANSPORT=ws

# Opcional: URL explicita do WebSocket. Vazio = mesma origem, ws(s)://<host>/api/ws
NEXT_PUBLIC_WS_URL=

# Somente se NEXT_PUBLIC_TRANSPORT=supabase
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
